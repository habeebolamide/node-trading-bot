NODE_ENV=development
DATABASE_URL=postgresql://mac@127.0.0.1:55432/trading_bot_dev
TEST_DATABASE_URL=postgresql://mac@127.0.0.1:55432/trading_bot_test
API_HOST=127.0.0.1
API_PORT=3000
RUNTIME_HEALTH_PORT=3001
WORKER_HEALTH_PORT=3002
LOG_LEVEL=info
EXECUTION_MODE=PAPER
# Optional public-data research watchlist; bots declare their requirements in later phases.
MARKET_DATA_WATCHLIST=[]
MARKET_HEARTBEAT_MAX_AGE_MS=65000
MARKET_REPAIR_INTERVAL_MS=5000
# Optional full versioned JSON policy; omitted uses documented paper-risk-v1 defaults.
# PAPER_RISK_POLICY_JSON supports stricter risk/exposure limits, configurable execution costs and latency.
