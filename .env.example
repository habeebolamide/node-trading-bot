# ─────────────────────────────────────────────────────────────
# Trading Intelligence Platform — environment template
# Copy to .env and fill in. All vars are validated at startup by
# packages/domain config.ts (Zod) — never read process.env directly.
# ─────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development           # development | test | production
LOG_LEVEL=info                 # debug | info | warn | error
API_PORT=3000

# Dashboard → API base URL for the Vite dev proxy (apps/dashboard). Change this if the api
# listens on a non-default port or on a different host. Vite proxies /api/* and /trading-agents/*
# and /ws/* to this target. Default: http://localhost:${API_PORT}.
DASHBOARD_API_URL=http://localhost:3000

# --- Postgres (hosted: Neon or Supabase) ---
# DATABASE_URL is the pooled connection used by the app at runtime.
# DIRECT_URL is the non-pooled connection used by drizzle-kit migrations.
DATABASE_URL=postgres://user:pass@host:5432/db
DIRECT_URL=postgres://user:pass@host:5432/db

# --- Redis + BullMQ (hosted: Upstash) ---
# NOTE: required by the plan (queues, §11). Provision an Upstash Redis
# instance and paste its rediss:// URL here.
REDIS_URL=rediss://default:pass@host:6379

# --- Bybit (perp domain, Part III §5) ---
# Public market data (WS/REST) needs no keys; keys only required for
# private endpoints. BYBIT_TESTNET=true routes to testnet hosts.
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_TESTNET=false

# --- Helius (memecoin domain, Part II §7 — free tier, 30M CU/month) ---
# NOTE: not present in the legacy .env — provision at https://helius.dev
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=          # shared secret to authenticate inbound webhooks
# Public URL of apps/api's /webhooks/helius endpoint (e.g. https://<ngrok-id>.ngrok.app/webhooks/helius).
# Required for m3-watchlist to auto-manage the Helius subscription; optional otherwise.
HELIUS_WEBHOOK_URL=

# --- DeepSeek (Judge + autopsy, perp-only in MVP, §18/§24) ---
DEEPSEEK_API_KEY=

# --- Telegram (fast-lane fill/close alerts, §11) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
