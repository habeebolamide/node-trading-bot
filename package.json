{
  "name": "strategy-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "tsx --env-file-if-exists=.env apps/api/src/main.ts",
    "dev:runtime": "tsx --env-file-if-exists=.env apps/runtime/src/main.ts",
    "dev:worker": "tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "dev:web": "npm run dev -w @platform/web",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && npm run build -w @platform/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check": "npm run typecheck && npm test && npm run test:integration && npm run build && npm run security:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env packages/database/src/migrate.ts",
    "bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts",
    "start:api": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "start:runtime": "node --env-file-if-exists=.env dist/apps/runtime/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/apps/worker/src/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "market:seed": "tsx --env-file-if-exists=.env scripts/market-seed.ts",
    "strategies:register": "tsx --env-file-if-exists=.env scripts/register-strategies.ts",
    "strategy:preview": "tsx --env-file-if-exists=.env scripts/strategy-preview.ts",
    "backtest": "tsx --env-file-if-exists=.env scripts/backtest.ts",
    "recovery:replay": "tsx --env-file-if-exists=.env scripts/recover.ts",
    "dev:notifier": "tsx --env-file-if-exists=.env apps/notifier/src/main.ts",
    "start:notifier": "node --env-file-if-exists=.env dist/apps/notifier/src/main.js",
    "ops:backup": "tsx --env-file-if-exists=.env scripts/backup.ts backup",
    "ops:restore": "tsx --env-file-if-exists=.env scripts/backup.ts restore",
    "security:check": "node scripts/security-check.mjs",
    "ops:token": "tsx --env-file-if-exists=.env scripts/tokens.ts",
    "ops:verify": "tsx --env-file-if-exists=.env scripts/verify-ledger.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "talib": "1.1.6",
    "ws": "^8.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
