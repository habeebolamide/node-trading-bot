      "checkConstraints": {
        "candle_closed_ohlc": {
          "name": "candle_closed_ohlc",
          "value": "\"candles\".\"is_closed\"=true AND \"candles\".\"open\">0 AND \"candles\".\"low\">0 AND \"candles\".\"volume\">=0 AND \"candles\".\"high\">=greatest(\"candles\".\"open\",\"candles\".\"close\") AND \"candles\".\"low\"<=least(\"candles\".\"open\",\"candles\".\"close\") AND \"candles\".\"high\">=\"candles\".\"low\""
        },
        "candle_time_availability": {
          "name": "candle_time_availability",
          "value": "\"candles\".\"open_time\">=0 AND \"candles\".\"close_time\"<=\"candles\".\"available_at\" AND \"candles\".\"available_at\"<=\"candles\".\"observed_at\""
        },
        "candle_timeframe_alignment": {
          "name": "candle_timeframe_alignment",
          "value": "CASE \"candles\".\"timeframe\" WHEN '1m' THEN \"candles\".\"close_time\"-\"candles\".\"open_time\"=60000 AND \"candles\".\"open_time\"%60000=0 WHEN '5m' THEN \"candles\".\"close_time\"-\"candles\".\"open_time\"=300000 AND \"candles\".\"open_time\"%300000=0 WHEN '15m' THEN \"candles\".\"close_time\"-\"candles\".\"open_time\"=900000 AND \"candles\".\"open_time\"%900000=0 WHEN '1h' THEN \"candles\".\"close_time\"-\"candles\".\"open_time\"=3600000 AND \"candles\".\"open_time\"%3600000=0 WHEN '4h' THEN \"candles\".\"close_time\"-\"candles\".\"open_time\"=14400000 AND \"candles\".\"open_time\"%14400000=0 ELSE false END"
        }
      },
      "isRLSEnabled": false
    },
