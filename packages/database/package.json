    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@tip/domain": "*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1"
  }
}
