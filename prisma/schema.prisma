// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Agent {
  id                String        @id @default(uuid())
  name              String
  pair              String
  allocationPercent Float         @default(10.0)
  riskPercent       Float         @default(1.0)
  mode              String        // "paper" | "live"
  tradingStyle      String
  status            String        @default("active")
  leverage          Float         @default(10.0)

  learnedRules      Json?

  monthlyPnL        Float         @default(0)
  totalTrades       Int           @default(0)
  winRate           Float         @default(0)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  trades            Trade[]
  lessons           TradeLesson[]  
  signals Signal[]

  @@map("agents")
}

model Trade {
  id            String   @id @default(uuid())
  agentId       String
  pair          String
  direction     String   // LONG | SHORT
  entryPrice    Float
  stopLoss      Float
  takeProfit    Float?
  size          Float
  status        String   // open | closed | cancelled
  exitPrice     Float?
  realizedPnL   Float?
  closeReason   String?
  duration      Int?     // in seconds or minutes

  entrySnapshot Json?    // { regime, rsi, volumeRatio, news } captured at executeEntry, read by post-mortem

  openedAt      DateTime @default(now())
  closedAt      DateTime?

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  trade_lesson TradeLesson[]

  @@map("trades")
}

model TradeLesson {
  id          String   @id @default(uuid())
  tradeId     String?
  agentId     String
  rule        String   
  tag         String   
  description String

  createdAt   DateTime @default(now())

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  trade       Trade?   @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@map("trade_lessons")
}

model Candle {
  id        String   @id @default(uuid())
  pair      String
  timeframe String
  timestamp BigInt
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  @@unique([pair, timeframe, timestamp])
  @@map("candles")
}

model BacktestResult {
  id        String   @id @default(uuid())
  agentId   String
  config    Json
  result    Json
  createdAt DateTime @default(now())

  @@map("backtest_results")
}

model PendingSignal {
  id          String   @id @default(uuid())
  agentId     String
  pair        String
  direction   String   // LONG | SHORT
  status      String  // PENDING | EXPIRED
  entryPrice  Float
  tp          Float
  sl          Float
  positionSize Float
  confidence  Int
  reasoning   String
  rawSignal   Json
  expiresAt   DateTime // signal is only valid until this time
  createdAt   DateTime @default(now())

  @@map("pending_signals")
}

model Signal {
  id            String    @id @default(uuid())
  agentId       String
  pair          String?
  action        String    // LONG | SHORT | NO_TRADE
  entry         Float?
  tp            Float?
  sl            Float?
  positionSize  Float?
  confidence    Float?
  tradeStyle    String?
  timeframeUsed String?
  reasoning     String?
  whatInvalidates String?
  entryExpiry   DateTime?
  triggers      Json      // { price_up, price_down, timeout }
  status        String    @default("active") // active | triggered | expired | executed | cancelled
  rawSignal     Json
  triggeredBy   String?   // ENTRY_HIT | PRICE_UP | PRICE_DOWN | TIMEOUT | EXPIRY
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())

  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("signals")
}