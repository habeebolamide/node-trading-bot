// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Agent {
  id                String        @id @default(uuid())
  name              String
  pair              String
  allocationPercent Float         @default(10.0)
  riskPercent       Float         @default(1.0)
  mode              String        // "paper" | "live"
  tradingStyle      String
  status            String        @default("active")
  leverage          Float         @default(10.0)
  maxMarginPct      Float         @default(1.0)

  learnedRules      Json?

  monthlyPnL        Float         @default(0)
  totalTrades       Int           @default(0)
  winRate           Float         @default(0)

  lastSynthesisAt   DateTime?

  // ─── Challenge mode ───
  // Toggle only. To run a challenge: create a ChallengeSession row with
  // status='pending' and the config you want, then flip challengeMode=true.
  // The reconciler picks up the pending session and activates it.
  // See guides/CHALLENGE_MODE.md.
  challengeMode     Boolean       @default(false)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  trades            Trade[]
  lessons           TradeLesson[]
  signals           Signal[]
  challengeSessions ChallengeSession[]

  @@map("agents")
}

model Trade {
  id            String   @id @default(uuid())
  agentId       String
  pair          String
  direction     String   // LONG | SHORT
  entryPrice    Float
  stopLoss      Float
  takeProfit    Float?
  size          Float
  status        String   // open | closed | cancelled
  exitPrice     Float?
  realizedPnL   Float?
  closeReason   String?
  duration      Int?     // in seconds or minutes
  leverage      Float    @default(10.0)
  mode          String?  // "paper" | "live" — per-trade override. Falls back to agent.mode when null.

  entrySnapshot Json?    // { regime, rsi, volumeRatio, news } captured at executeEntry, read by post-mortem

  unrealisedPnl Float?   @default(0)  // updated by updateLivePnl, throttled to 10s, for dashboard visibility
  unrealisedPct Float?   @default(0)

  // Challenge mode — non-null when this trade was opened during an active challenge session.
  challengeId      String?
  challengeSession ChallengeSession? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  openedAt      DateTime @default(now())
  closedAt      DateTime?

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  trade_lesson TradeLesson[]

  @@map("trades")
}

model TradeLesson {
  id          String   @id @default(uuid())
  tradeId     String?
  agentId     String
  rule        String
  tag         String
  description String

  // "loss" (a mistake to avoid) | "win" (a pattern to repeat). Defaults to
  // "loss" so existing rows — all generated by the loss-only post-mortem —
  // backfill correctly.
  outcome     String   @default("loss")
  // Loss verdict (bad_trade | bad_luck | bad_management) and whether the loss
  // was avoidable. The post-mortem already computes these; they were being
  // dropped on save. bad_luck / avoidable=false lessons are persisted for the
  // record but NOT surfaced as rules — they would suppress good setups.
  verdict     String?
  avoidable   Boolean?

  createdAt   DateTime @default(now())

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  trade       Trade?   @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@map("trade_lessons")
}

model Candle {
  id        String   @id @default(uuid())
  pair      String
  timeframe String
  timestamp BigInt
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  @@unique([pair, timeframe, timestamp])
  @@map("candles")
}

model BacktestResult {
  id        String   @id @default(uuid())
  agentId   String
  config    Json
  result    Json
  createdAt DateTime @default(now())

  @@map("backtest_results")
}

model PendingSignal {
  id          String   @id @default(uuid())
  agentId     String
  pair        String
  direction   String   // LONG | SHORT
  status      String  // PENDING | EXPIRED
  entryPrice  Float
  tp          Float
  sl          Float
  positionSize Float
  confidence  Int
  reasoning   String
  rawSignal   Json
  expiresAt   DateTime // signal is only valid until this time
  createdAt   DateTime @default(now())

  @@map("pending_signals")
}

model Signal {
  id            String    @id @default(uuid())
  agentId       String
  pair          String?
  action        String    // LONG | SHORT | NO_TRADE
  entry         Float?
  tp            Float?
  sl            Float?
  positionSize  Float?
  confidence    Float?
  tradeStyle    String?
  timeframeUsed String?
  reasoning     String?
  whatInvalidates String?
  entryExpiry   DateTime?
  triggers      Json      // { price_up, price_down, timeout }
  status        String    @default("active") // active | triggered | expired | executed | cancelled
  rawSignal     Json
  triggeredBy   String?   // ENTRY_HIT | PRICE_UP | PRICE_DOWN | TIMEOUT | EXPIRY
  triggeredAt   DateTime?
  leverage      Float?    @default(10.0)

  // Challenge mode — non-null when this signal was created during an active challenge session.
  // Required (alongside Trade.challengeId) so the websocket entry-hit re-validation path
  // routes through the challenge sandbox instead of the main pool.
  challengeId      String?
  challengeSession ChallengeSession? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())

  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("signals")
}

// ─────────────────────────────────────────────
// Challenge mode session
// One row per challenge run (active or historical). Active session is
// pointed to by Agent.currentChallengeSessionId. See guides/CHALLENGE_MODE.md.
// ─────────────────────────────────────────────

model ChallengeSession {
  id               String    @id @default(uuid())
  agentId          String

  // ─── Config — set by user at creation, immutable after activation ───
  startingCapital  Float
  targetCapital    Float
  durationDays     Int       @default(30)
  maxDrawdownPct   Float     @default(0.5)
  // Per-trade risk cap, expressed as % of the per-trade MARGIN allocation
  // (NOT % of bucket equity). Nested with maxMarginPct:
  //   maxMargin   = bucketEquity × maxMarginPct
  //   maxLossThisTrade = maxMargin × (riskPercent / 100)
  // e.g. $5 bucket × 30% allocation = $1.50 margin; × 50% risk = $0.75 max loss.
  // Default 50 = "risk half of the per-trade allocation" which pairs
  // sensibly with the maxMarginPct default of 20-30%.
  riskPercent      Float     @default(50.0)
  // Leverage comes from the agent (Agent.leverage), NOT the session. Keeping
  // one source of truth avoids drift and avoids the LLM seeing two
  // potentially different leverage values across system + entry prompts.
  minNotionalFloor Float     @default(5.0)
  // Cap on margin per trade as a fraction of bucket equity. 0.2 = 20% =
  // a single trade can lock at most $1 of a $5 bucket. Protects against
  // tight-stop trades that would otherwise lock the full bucket as margin
  // (the actual MAX LOSS is still riskPercent, this is the EXPOSURE cap).
  // Set to 1.0 to disable (whole bucket can be margin, original behaviour).
  maxMarginPct     Float     @default(0.2)
  executionMode    String    @default("paper")  // "paper" | "live"

  // ─── Lifecycle — populated by the bot ───
  // status flow: pending → active → (passed | failed | expired | cancelled)
  status           String    @default("pending")
  startsAt         DateTime?                     // set when status → active
  endsAt           DateTime?                     // computed at activation as startsAt + durationDays
  endedAt          DateTime?                     // set on any terminal status
  finalEquity      Float?
  finalReturnPct   Float?
  failReason       String?
  result           Json?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  trades           Trade[]
  signals          Signal[]

  @@index([agentId, status])
  @@map("challenge_sessions")
}