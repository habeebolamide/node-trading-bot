{
  "compilerOptions": {
    /* Base Options */
    "target": "ES2023",
    "module": "NodeNext", // Changed from 'ESNext' for better Node compatibility
    "moduleResolution": "nodenext", // Changed from 'bundler' for better Node compatibility
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Naming & Layout */
    "rootDir": "./", // Allows prisma.config.ts at root to be included
    "outDir": "./dist",

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true, // Required for clean ESM imports
    "isolatedModules": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Output */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* React Support (Keeping this for your React Dashboard compatibility) */
    "jsx": "react-jsx"
  },
  "include": [
    "index.ts",
    "agents/**/*.ts",
    "backtest/**/*.ts",
    "capital/**/*.ts",
    "claude/**/*.ts",
    "execution/**/*.ts",
    "learning/**/*.ts",
    "lib/**/*.ts",
    "markets/**/*.ts",
    "risk/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "prisma/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist", "generated", "logs"]
}